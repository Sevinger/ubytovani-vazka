# Rezervační formulář
#
# Bez těchto proměnných formulář stále funguje: místo odeslání e-mailu ze
# serveru otevře hostovi jeho poštovního klienta s předvyplněnou poptávkou.
# Jakmile klíč doplníte, začne se odesílat na pozadí a host už nic dalšího
# nedělá.

# API klíč z https://resend.com/api-keys
RESEND_API_KEY=

# Odesílatel. Musí být na doméně ověřené v Resendu.
# Dokud doménu neověříte, jde použít onboarding@resend.dev.
BOOKING_FROM="Rezervace Vážka <rezervace@ubytovanivazka.cz>"

# Kam poptávky chodí. Výchozí je ubytovanivazka@seznam.cz.
BOOKING_TO=ubytovanivazka@seznam.cz
